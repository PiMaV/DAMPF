# PyInstaller / EXE build (track build/DAMPF.spec; ignore other build/ artifacts)
build/**
!build/DAMPF.spec
dist/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.eggs/

# Tests / tools
.pytest_cache/
.coverage
htmlcov/

# IDE / OS
.idea/
.vscode/
*.swp
Thumbs.db

# Local GUI settings (paths, window size) — never ship; template is config/dampf.ini
/dampf.ini
